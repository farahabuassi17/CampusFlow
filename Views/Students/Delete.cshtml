@model CampusFlow.Mvc.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">

    <h1>Delete Student</h1>

    <div class="alert alert-danger mt-3">
        Are you sure you want to delete this student?
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-3">
                <strong>Student Name:</strong>
                <span>@Model.Name</span>
            </div>

            <div class="mb-3">
                <strong>Email:</strong>
                <span>@Model.Email</span>
            </div>

            <div class="mb-3">
                <strong>Course:</strong>
                <span>@Model.Course?.Name</span>
            </div>

            <form asp-controller="Students" asp-action="Delete" asp-route-id="@Model.StudentId" method="post">

                <input type="hidden" asp-for="StudentId" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-controller="Students" asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>