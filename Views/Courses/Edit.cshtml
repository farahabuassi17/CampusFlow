@model CampusFlow.Mvc.Models.Course

<div class="container mt-4">

    <h1>Edit Course</h1>
    <p class="text-muted">Update course information</p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <form asp-controller="Courses"
                  asp-action="Edit"
                  asp-route-id="@Model.CourseId"
                  method="post">

                <input type="hidden"
                       asp-for="CourseId" />

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label">
                        Course Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CreditHours"
                           class="form-label">
                        Credit Hours
                    </label>

                    <input asp-for="CreditHours"
                           class="form-control" />

                    <span asp-validation-for="CreditHours"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
